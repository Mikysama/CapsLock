{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capslock.local/schemas/policy-evaluation-report-v1.json",
  "title": "CapsLock Policy Evaluation Report",
  "type": "object",
  "required": ["schema_version", "status", "manifest", "metrics_registry", "summary", "sample_count", "report_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["completed", "failed"]},
    "manifest": {
      "type": "object",
      "required": ["stage", "matrix_fingerprint", "task_set_hash", "git_commit", "seed", "repetitions"],
      "properties": {
        "stage": {"enum": ["deterministic", "screen", "confirm"]},
        "matrix_fingerprint": {"type": "string", "minLength": 8},
        "task_set_hash": {"type": "string", "minLength": 32},
        "git_commit": {"type": "string"},
        "seed": {"type": "integer"},
        "repetitions": {"type": "integer", "minimum": 1}
      }
    },
    "metrics_registry": {"type": "array", "minItems": 1},
    "summary": {
      "type": "object",
      "required": ["candidates", "pareto_fingerprints", "recommendation"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/candidate_summary"}
        },
        "pareto_fingerprints": {"type": "array", "items": {"type": "string"}},
        "recommendation": {"type": ["object", "null"]}
      }
    },
    "sample_count": {"type": "integer", "minimum": 1},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "candidate_summary": {
      "type": "object",
      "required": [
        "name",
        "fingerprint",
        "values",
        "raw_samples",
        "raw_successes",
        "success_rate",
        "raw_success_rate",
        "quality_success_rate",
        "capacity_coverage",
        "safe_stop_rate",
        "provider_error_rate",
        "approval_bypasses",
        "unknown_execution_auto_replays",
        "gate_failures",
        "feasible"
      ],
      "properties": {
        "name": {"type": "string"},
        "fingerprint": {"type": "string", "minLength": 8},
        "values": {"type": "object", "additionalProperties": {"type": "number"}},
        "success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "raw_samples": {"type": "integer", "minimum": 0},
        "raw_successes": {"type": "integer", "minimum": 0},
        "raw_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "quality_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "capacity_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "safe_stop_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "provider_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "approval_bypasses": {"type": "integer", "minimum": 0},
        "unknown_execution_auto_replays": {"type": "integer", "minimum": 0},
        "gate_failures": {"type": "array", "items": {"type": "string"}},
        "feasible": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
