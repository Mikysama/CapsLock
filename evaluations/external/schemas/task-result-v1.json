{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capslock.local/schemas/external-task-result-v1.json",
  "type": "object",
  "required": [
    "schema_version", "suite", "suite_revision", "instance_id", "run_id",
    "run_ordinal", "model_track", "agent_terminal_status", "grader_status",
    "resolved", "artifact_kind", "input_tokens", "output_tokens", "cost_usd",
    "duration_seconds", "tool_rounds", "tool_calls", "changed_files",
    "changed_lines", "trajectory_path", "grader_log_path", "stderr_path",
    "result_hash"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "suite": {"type": "string", "minLength": 1},
    "suite_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instance_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "run_ordinal": {"type": "integer", "minimum": 1},
    "model_track": {"enum": ["flash", "pro"]},
    "agent_terminal_status": {"type": "string"},
    "grader_status": {"enum": ["not_run", "passed", "failed", "infrastructure_error"]},
    "resolved": {"type": "boolean"},
    "failure_category": {"type": ["string", "null"]},
    "stop_reason": {"type": ["string", "null"]},
    "artifact_kind": {"enum": ["git_patch", "environment_state"]},
    "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "duration_seconds": {"type": "number", "minimum": 0},
    "tool_rounds": {"type": "integer", "minimum": 0},
    "tool_calls": {"type": "integer", "minimum": 0},
    "changed_files": {"type": "integer", "minimum": 0},
    "changed_lines": {"type": "integer", "minimum": 0},
    "peak_context_tokens": {"type": "integer", "minimum": 0},
    "context_updates": {"type": "integer", "minimum": 0},
    "context_compactions": {"type": "integer", "minimum": 0},
    "human_interventions": {"type": ["integer", "null"], "minimum": 0},
    "trajectory_path": {"type": "string"},
    "grader_log_path": {"type": "string"},
    "stderr_path": {"type": "string"},
    "infrastructure_error": {"type": ["string", "null"]},
    "result_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
