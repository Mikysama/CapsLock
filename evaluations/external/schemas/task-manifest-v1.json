{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capslock.local/schemas/external-task-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "instance_id", "problem_statement", "workspace_source", "grader"],
  "properties": {
    "suite": {"type": "string", "minLength": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "problem_statement": {"type": "string", "minLength": 1},
    "workspace_source": {"type": "string", "minLength": 1},
    "repository": {"type": "string"},
    "language": {"type": "string"},
    "task_type": {"type": "string"},
    "gold_patch_size": {"type": "integer", "minimum": 0},
    "resource_class": {"type": "string", "minLength": 1},
    "grader": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "cwd": {"enum": ["harness", "workspace", "artifact"]},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "success_exit_code": {"type": "integer"},
        "success_substring": {"type": "string"},
        "environment": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
